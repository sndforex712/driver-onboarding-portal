{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:recruiting": "node ./scripts/run-recruiting-unit.mjs",
    "test:recruiting:case-order": "node ./scripts/run-recruiting-case-order-unit.mjs",
    "test:recruiting:sheet-sync": "node ./scripts/run-recruiting-sheet-sync-unit.mjs",
    "test:drivers-operational": "node ./scripts/run-drivers-operational-unit.mjs",
    "test:twenty-driver-queue": "node --experimental-strip-types --test src/lib/twenty-driver-candidates.test.ts",
    "test:auth": "node --experimental-strip-types --test src/lib/session-security.test.ts src/lib/role-guard.test.ts src/lib/demo-auth.test.ts",
    "test:operational-handoff": "node --experimental-strip-types --test src/lib/driver-operational-handoff.test.ts",
    "test:franklin-lead-ingest": "node --experimental-strip-types --test src/routes/franklin-lead-ingest.test.ts",
    "test:recruiting:postgres": "node ./scripts/run-recruiting-postgres.mjs",
    "seed:recruiting:demo": "RECRUITING_DEMO_SEED=1 node ./scripts/seed-recruiting-demo.mjs",
    "provision:demo-users": "node ./scripts/provision-demo-users.mjs",
    "recruiting:owner-routing": "node ./scripts/run-recruiter-owner-rebalance.mjs",
    "sync:franklin-operational-workflow": "node ./scripts/sync-franklin-operational-workflow.mjs",
    "sync:franklin-operational-workflow:reset-legacy": "NODE_ENV=development FRANKLINS_WORKFLOW_SYNC=1 FRANKLINS_WORKFLOW_SYNC_RESET_LEGACY=1 node ./scripts/sync-franklin-operational-workflow.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@replit/object-storage": "^1.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
